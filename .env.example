# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose dev default — change for production
DATABASE_URL="postgresql://gfl:gfl_dev_password@localhost:5433/gfl?schema=public"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Full public URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Required in production — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# When SMTP_HOST is unset, password reset links are logged to the server console.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="apikey-or-username"
# SMTP_PASS="secret"
# SMTP_FROM="GFL Survivor <no-reply@yourdomain.com>"

# ── Pick reminders (cron) ─────────────────────────────────────────────────────
# Shared secret guarding POST /api/admin/reminders/send. Set to enable the
# reminder cron; generate with: openssl rand -hex 32
CRON_SECRET=""
# Optional: hours before Thursday/Sunday kickoff the reminder window opens (default 3).
# REMINDER_LEAD_HOURS="3"
