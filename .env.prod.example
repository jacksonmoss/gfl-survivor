# Production environment for docker-compose.prod.yml.
# Copy to .env.prod, fill in real values, and keep it out of version control.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ── Postgres (the `db` service) ───────────────────────────────────────────────
POSTGRES_USER=gfl
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=gfl

# ── Database URL used by the app + migrator ───────────────────────────────────
# Host is the compose service name `db`, port 5432 (container-internal).
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://gfl:change-me-to-a-strong-password@db:5432/gfl?schema=public

# ── TLS / HTTPS (nginx + Let's Encrypt) ───────────────────────────────────────
# Public domain the app is served on. Must resolve to this host in DNS, with
# ports 80 and 443 reachable from the internet. Used for the nginx server name
# and the Let's Encrypt certificate. Bootstrap the first cert once with
# ./deploy/init-letsencrypt.sh; the `certbot` service renews it automatically.
DOMAIN=your-domain.com
# Contact email for Let's Encrypt (expiry notices). Required by the ACME account.
CERTBOT_EMAIL=you@example.com

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Public origin users reach the app on. Use the https:// DOMAIN above (no
# trailing slash) — this makes NextAuth issue Secure cookies. HTTP is redirected
# to HTTPS by nginx.
NEXTAUTH_URL=https://your-domain.com

# REQUIRED. The app refuses to start in production without this.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# When unset, password-reset links are logged to the app container's console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey-or-username
# SMTP_PASS=secret
# SMTP_FROM=GFL Survivor <no-reply@yourdomain.com>

# ── Pick reminders (the `reminders` sidecar) ──────────────────────────────────
# Shared secret the reminders sidecar sends as `Authorization: Bearer` when it
# polls the app's reminders endpoint. Set this to enable reminders; leave it
# unset and the sidecar idles (the endpoint returns 503). Reminders only email
# when SMTP is configured above — otherwise they log to the app console.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Seconds between polls (default 900 = 15 min). The endpoint self-gates to slot
# windows, so a short interval just means it no-ops more often.
# REMINDER_INTERVAL=900
# Hours before kickoff to send the reminder slot (default 3).
# REMINDER_LEAD_HOURS=3

# ── Betting spreads (optional) ────────────────────────────────────────────────
# The Odds API key (https://the-odds-api.com/, free tier 500 req/month). When
# unset, matchup cards omit the spread — the feature degrades gracefully.
# ODDS_API_KEY=

# ── Database backups (the `backup` service) ───────────────────────────────────
# The backup service pg_dumps the DB into ./backups on a schedule and prunes to
# the newest BACKUP_KEEP dumps. Defaults: daily, keep 7. Uncomment to override.
# BACKUP_INTERVAL=86400   # seconds between dumps (86400 = daily)
# BACKUP_KEEP=7           # number of dumps to retain
