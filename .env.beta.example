# Beta environment for docker-compose.beta.yml — a local, prod-parity install
# you can point a customer at for beta testing. Copy to .env.beta and edit.
#
# Everything here has a working default: `./scripts/beta.sh up` runs fine with
# no .env.beta at all. Copy this file only when you want to override something
# (a real SMTP account, an odds key, a different port).
#
#   cp .env.beta.example .env.beta
#   ./scripts/beta.sh up
#
# NOTE: NEXTAUTH_URL and NEXTAUTH_SECRET are NOT set here. beta.sh resolves the
# public URL from the tunnel at startup and generates a secret on first run,
# writing both to .env.beta.runtime (generated, gitignored, do not edit).

# ── Compose project name ──────────────────────────────────────────────────────
# Pinned so the beta database can never share a volume with the dev stack
# (docker-compose.yml) or the prod stack. Do not remove this.
COMPOSE_PROJECT_NAME=gfl-beta

# ── Postgres ──────────────────────────────────────────────────────────────────
# This DB holds throwaway beta data and is bound to loopback only, so a weak
# default is fine. It is NOT a production credential.
POSTGRES_USER=gfl
POSTGRES_PASSWORD=gfl_beta_password
POSTGRES_DB=gfl
DATABASE_URL=postgresql://gfl:gfl_beta_password@db:5432/gfl?schema=public

# Host port for poking at the DB with psql during a demo (loopback only).
# Differs from the dev stack's 5433 so both can run simultaneously.
# DB_PORT=5434

# ── App ───────────────────────────────────────────────────────────────────────
# Host port the app is published on. Change if 3000 is already taken.
# APP_PORT=3000

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Unset (the default) means password-reset links and pick reminders are written
# to the app container's log instead of emailed:
#   ./scripts/beta.sh logs
# That is usually what you want for a beta — testers can't receive mail at a
# throwaway address anyway, and you can read the reset link out of the log. Set
# these only if the customer specifically wants to sign off on real email.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_FROM=GFL Survivor Beta <no-reply@example.com>

# ── Pick reminders (optional) ─────────────────────────────────────────────────
# The beta stack does NOT run the reminders sidecar — a beta session is too
# short for a scheduled poll to fire. Set a secret here and trigger a send by
# hand when you want to demo reminders; see docs/BETA-TESTING.md.
# Generate with: openssl rand -hex 32
# CRON_SECRET=
# REMINDER_LEAD_HOURS=3

# ── Betting spreads (optional) ────────────────────────────────────────────────
# The Odds API key (https://the-odds-api.com/, free tier 500 req/month). Unset
# means matchup cards omit the spread — the feature degrades gracefully.
# The `demo` seed ships its own spreads, so the stats page's upset detection is
# demonstrable without a key.
# ODDS_API_KEY=

# ── Demo mode ─────────────────────────────────────────────────────────────────
# On by default in this stack (docker-compose.beta.yml). Adds "Simulate week" /
# "Reset week" controls to the picks page: random picks for everyone who hasn't
# picked, final scores, and grading — the whole weekend in one click, so a
# customer can see the loop close in a beta session. Any signed-in user can
# press it, so never enable this on a real league.
# DEMO_MODE=false
